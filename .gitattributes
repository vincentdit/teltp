# Default: let git normalize text line endings on commit.
* text=auto

# Files that MUST stay LF (they run inside Linux containers or tools that reject CRLF).
Dockerfile      text eol=lf
*.sh            text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only scripts keep CRLF.
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Treat these as binary (no EOL munging, no diffs).
*.jar           binary
*.png           binary
*.jpg           binary
*.ico           binary
*.pdf           binary
