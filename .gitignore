# ---- Java / Maven (backend) ----
target/
*.class
*.jar
*.war
!teltp-backend/.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Node / Angular (frontend) ----
node_modules/
dist/
.angular/
