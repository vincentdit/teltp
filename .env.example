# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# Database
DB_NAME=teltp
DB_USER=teltp
DB_PASSWORD=teltp
DB_ROOT_PASSWORD=change_me_root

# JWT signing secret — MUST be at least 64 characters (512 bits) for HS512.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars-0123456789abcdef

# Public site URL used in password-reset links.
PUBLIC_BASE_URL=http://localhost:9090

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:9090,http://localhost:4200

# Shared secret for the GePG callback. Leave empty to reject every callback (fail closed).
# Header X-Teltp-Signature is hex HMAC-SHA256 of controlNumber|providerReference|paidAmount.
GEPG_CALLBACK_SECRET=

# Optional live integrations. Leave blank until the provider is provisioned.
# MAIL_HOST= MAIL_PORT=1025 MAIL_USER= MAIL_PASSWORD=
# SMS_GATEWAY_URL=
# NIDA_ENDPOINT=
# GEPG_SP_CODE=
