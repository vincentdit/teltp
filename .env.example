# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# Database
DB_NAME=teltp
DB_USER=teltp
DB_PASSWORD=teltp
DB_ROOT_PASSWORD=change_me_root

# JWT signing secret — MUST be at least 64 characters (512 bits) for HS512.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars-0123456789abcdef
